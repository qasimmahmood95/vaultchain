{
  "name": "vaultchain",
  "version": "0.1.0",
  "private": true,
  "description": "Fictional mock digital-asset custody platform — the system-under-test for a showcase Playwright test architecture. No real crypto, keys, or money.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test:serve": "tsx scripts/test-serve.ts",
    "test:contract": "playwright test --project=contract",
    "test:workflow": "playwright test --project=workflow",
    "test:compliance": "playwright test --project=compliance",
    "test": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "eta": "^4.6.0",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.18.0",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "zod": "^4.4.3"
  }
}
